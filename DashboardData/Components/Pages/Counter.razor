@page "/counter"
@rendermode InteractiveServer
@using DashboardData.Services
@inject UserCounterService CounterService

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p>Instance ID: @CounterService.InstanceId</p>
<p>Count: @CounterService.Count</p>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header">
                <h5>🔄 Local Counter (component state)</h5>
            </div>
            <div class="card-body">
                <p role="status">Current count: <strong>@currentCount</strong></p>
                <button class="btn btn-primary" @onclick="IncrementCount">Increment local</button>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header">
                <h5>🌍 DI Counter (@GetLifetimeText())</h5>
            </div>
            <div class="card-body">
                <p role="status">DI count: <strong>@CounterService.Count</strong></p>
                <button class="btn btn-success" @onclick="() => CounterService.Increment()">Increment DI</button>
            </div>
        </div>
    </div>
</div>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }

    private string GetLifetimeText()
    {
        // This is just a helper to show which lifetime is currently active.
        // You need to manually change this string when you change the registration in Program.cs.
        return "Scoped (one per circuit)";
    }
}