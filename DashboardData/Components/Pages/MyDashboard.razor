@page "/dashboard"
@rendermode InteractiveServer
@using DashboardData.Models
@using DashboardData.Services
@inject ISensorService SensorService
@inject IJSRuntime JS
@using DashboardData.Components.UI

<PageTitle>Mon Dashboard</PageTitle>

<h1>Tableau de Bord</h1>

<div class="alert alert-info">
    Nous sommes le : <strong>@DateTime.Now.ToString("dd MMMM yyyy")</strong>
</div>

<button class="btn btn-outline-secondary mb-3" @onclick="() => showAsCards = !showAsCards">
    @(showAsCards ? "📋 Vue tableau" : "🃏 Vue cartes")
</button>

<!-- KPIs Cards -->
<div class="row mb-4">
    <div class="col-md-4">
        <KpiCard Title="📊 Total sondes" Value="@totalCount.ToString()" BackgroundColorClass="bg-primary"
            IconClass="bi-box-seam" />
    </div>
    <div class="col-md-4">
        <KpiCard Title="📈 Moyenne globale" Value="@($"{averageValue:F1} °C")" BackgroundColorClass="bg-success"
            IconClass="bi-bullseye)" />
    </div>
    <div class="col-md-4">
        <KpiCard Title="🔥 Valeur max" Value="@($"{maxValue:F1} °C")" BackgroundColorClass="bg-danger"
            IconClass="bi-exclamation-triangle-fill" />
    </div>
</div>

<!-- Filter buttons -->
<div class="mb-3 btns-wrapper-dash">
    <a href="/edit-sensor" class="btn btn-success">➕ Nouveau capteur</a>
    <button class="btn btn-secondary me-2" @onclick="LoadAll">📋 Toutes les sondes</button>
    <button class="btn btn-warning" @onclick="LoadCritical">⚠️ Alertes (&gt; 30.0)</button>
</div>

@if (isLoading)
{
    <p><em>Chargement des données...</em></p>
}
else
{
    @if (showAsCards)
    {
        <div class="row">
            @foreach (var sensor in sensors)
            {
                <div class="col-md-4 mb-3">
                    <SensorCard Sensor="sensor" OnDeleteClicked="DeleteSensor" />
                </div>
            }
        </div>
    }
    else
    {
        <SensorTable Sensors="sensors" OnDeleteClicked="DeleteSensor" />
    }
}

@code {
    private bool IsSystemOK = true;
    private string LastLog = "Rien à signaler";
    private List<SensorData> sensors = new();
    private bool isLoading = true;
    private bool showAsCards = false;

    // 🟣🟣🟣 KPI VARIABLES
    private int totalCount = 0;
    private double averageValue = 0;
    private double maxValue = 0;

    // 🟣🟣🟣 KPI METHODS

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
        await LoadKPIs();
    }

    private async Task LoadAll()
    {
        isLoading = true;
        sensors = await SensorService.GetSensorsAsync();
        isLoading = false;
    }

    private async Task LoadCritical()
    {
        isLoading = true;
        sensors = await SensorService.GetCriticalSensorsAsync(30.0);
        isLoading = false;
    }

    private async Task LoadKPIs()
    {
        totalCount = await SensorService.GetTotalCountAsync();
        averageValue = await SensorService.GetAverageValueAsync();
        maxValue = await SensorService.GetMaxValueAsync();
    }

    private void RefreshSystem()
    {
        var rnd = new Random();
        IsSystemOK = rnd.Next(0, 10) > 2;
        LastLog = IsSystemOK ? "Tout va bien" : "Anomalie détectée !";
    }

    // 🟣🟣🟣 CRUD METHODS - DELETE
    @* private async Task DeleteSensor(int id)
{
await SensorService.DeleteSensorAsync(id);
await LoadAll();
await LoadKPIs();
} *@

    private async Task DeleteSensor(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("window.confirm", "Voulez-vous vraiment supprimer ce capteur ?");
        if (!confirmed) return;

        await SensorService.DeleteSensorAsync(id);
        await LoadAll();
        await LoadKPIs();
    }

}