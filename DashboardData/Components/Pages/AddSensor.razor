@page "/add-sensor"
@rendermode InteractiveServer
@using DashboardData.Models
@using DashboardData.Services
@inject ISensorService SensorService
@inject NavigationManager NavManager

<h3>➕ Ajouter un capteur</h3>

<div class="mb-3">
    <label class="form-label">Nom</label>
    <input @bind="newSensorName" class="form-control" />
</div>
<div class="mb-3">
    <label class="form-label">Valeur</label>
    <input type="number" @bind="newSensorValue" class="form-control" />
</div>
<button class="btn btn-primary" @onclick="AddNewSensor">Ajouter</button>
<a href="/dashboard" class="btn btn-secondary">Annuler</a>

@code {
    private string newSensorName = "";
    private double newSensorValue = 0;

    private void AddNewSensor()
    {
        if (!string.IsNullOrWhiteSpace(newSensorName))
        {
            var sensor = new SensorData { Name = newSensorName, Value = newSensorValue };
            SensorService.AddSensor(sensor);
            NavManager.NavigateTo("/dashboard");
        }
    }
}